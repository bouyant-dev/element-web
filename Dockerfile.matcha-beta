# Build context is apps/web/webapp, after the tested production build.
ARG ELEMENT_VERSION
FROM vectorim/element-web:${ELEMENT_VERSION}

USER root
RUN rm -rf /app
COPY --chown=nginx:nginx . /app
USER nginx
